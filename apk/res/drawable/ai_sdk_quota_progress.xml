<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="#ff3f3f46" />
            <corners android:radius="4.0dip" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <gradient android:startColor="@color/theme_color_primary" android:endColor="@color/ai_sdk_brand_violet" android:angle="0.0" android:type="linear" android:centerColor="@color/ai_sdk_brand_peach" />
                <corners android:radius="4.0dip" />
            </shape>
        </clip>
    </item>
</layer-list>
