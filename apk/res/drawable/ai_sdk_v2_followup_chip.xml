    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ai_sdk_v2_followup_bg" />
            <stroke android:width="1.0dip" android:color="@color/ai_sdk_v2_followup_border" />
            <corners android:radius="14.0dip" />
        </shape>
    </item>
</selector>
