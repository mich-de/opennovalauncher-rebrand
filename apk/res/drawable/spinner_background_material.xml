<?xml version="1.0" encoding="utf-8"?>
<selector android:autoMirrored="true"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <item android:state_checked="true">
        <nine-patch android:src="@drawable/abc_spinner_mtrl_am_alpha" android:tint="?colorControlActivated" />
    </item>
    <item android:state_pressed="true">
        <nine-patch android:src="@drawable/abc_spinner_mtrl_am_pressed" android:tint="?colorControlActivated" android:tintMode="multiply" app:tintMode="multiply" />
    </item>
    <item>
        <nine-patch android:src="@drawable/abc_spinner_mtrl_am_alpha" android:tint="?colorControlNormal" />
    </item>
</selector>
