<?xml version="1.0" encoding="utf-8"?>
<shortcuts
  xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut android:icon="@drawable/launcher_shortcut_default_home" android:enabled="true" android:shortcutId="set_default_launcher" android:shortcutShortLabel="@string/app_shortcut_set_default">
        <intent android:targetPackage="com.teslacoilsw.launcher" android:action="com.teslacoilsw.launcher.ACTION" android:targetClass="com.teslacoilsw.launcher.NovaShortcutHandler">
            <extra android:name="LAUNCHER_ACTION" android:value="SET_DEFAULT_LAUNCHER" />
        </intent>
    </shortcut>
    <shortcut android:icon="@drawable/launcher_shortcut_settings" android:enabled="true" android:shortcutId="nova_settings" android:shortcutShortLabel="@string/nova_settings">
        <intent android:targetPackage="com.teslacoilsw.launcher" android:action="android.intent.action.MAIN" android:targetClass="com.teslacoilsw.launcher.preferences.SettingsActivity" />
    </shortcut>
</shortcuts>
